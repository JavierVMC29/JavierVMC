---
import ContactPage from "@/components/pages/contact/ContactPage.astro";
import { GlobalMessageKeys, getLocaleStaticPaths, getTranslations, type Locale } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Paths } from "@/lib/paths";

export const getStaticPaths = getLocaleStaticPaths;

const locale = Astro.params.locale as Locale;
const t = getTranslations(locale, GlobalMessageKeys.Contact);
---

<BaseLayout locale={locale} path={Paths.Contact} title={t("title")} description={t("content")}>
  <ContactPage locale={locale} />
</BaseLayout>
