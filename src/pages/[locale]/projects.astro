---
import ProjectsPage from "@/components/pages/projects/ProjectsPage.astro";
import { GlobalMessageKeys, getLocaleStaticPaths, getTranslations, type Locale } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Paths } from "@/lib/paths";

export const getStaticPaths = getLocaleStaticPaths;

const locale = Astro.params.locale as Locale;
const t = getTranslations(locale, GlobalMessageKeys.Projects);
---

<BaseLayout locale={locale} path={Paths.Projects} title={t("title")} description={t("content")}>
  <ProjectsPage locale={locale} />
</BaseLayout>
