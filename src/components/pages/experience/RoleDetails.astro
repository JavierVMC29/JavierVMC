---
import { ChevronDown } from "@lucide/astro";
import { splitMetrics } from "@/lib/highlight";

interface Props {
  bullets: string[];
  skills: string[];
  showMoreLabel: string;
  showLessLabel: string;
}

const { bullets, skills, showMoreLabel, showLessLabel } = Astro.props;

/** Bullets visible before "Show more". */
const VISIBLE_BULLETS = 3;
const visible = bullets.slice(0, VISIBLE_BULLETS);
const hidden = bullets.slice(VISIBLE_BULLETS);

const bulletClass = "flex gap-3 text-secondary leading-relaxed";
const markerClass = "mt-[0.6em] size-1.5 shrink-0 rounded-full bg-violet-500/70";
---

<div class="flex flex-col gap-4">
  <ul class="flex flex-col gap-2.5">
    {
      visible.map((bullet) => (
        <li class={bulletClass}>
          <span class={markerClass} aria-hidden="true" />
          <span>
            {splitMetrics(bullet).map(({ text, metric }) =>
              metric ? <strong class="font-semibold text-foreground">{text}</strong> : text,
            )}
          </span>
        </li>
      ))
    }
  </ul>

  {
    hidden.length > 0 && (
      <details class="group">
        <summary class="inline-flex cursor-pointer list-none items-center gap-1 rounded-sm text-sm font-medium text-violet-700 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet-500 dark:text-violet-300 [&::-webkit-details-marker]:hidden">
          <span class="group-open:hidden">{showMoreLabel.replace("{count}", String(hidden.length))}</span>
          <span class="hidden group-open:inline">{showLessLabel}</span>
          <ChevronDown class="size-4 transition-transform group-open:rotate-180" />
        </summary>
        <ul class="mt-3 flex flex-col gap-2.5">
          {hidden.map((bullet) => (
            <li class={bulletClass}>
              <span class={markerClass} aria-hidden="true" />
              <span>
                {splitMetrics(bullet).map(({ text, metric }) =>
                  metric ? <strong class="font-semibold text-foreground">{text}</strong> : text,
                )}
              </span>
            </li>
          ))}
        </ul>
      </details>
    )
  }

  {
    skills.length > 0 && (
      <ul class="flex flex-wrap gap-2" aria-label="Stack">
        {skills.map((skill) => (
          <li class="rounded-md border bg-background px-2 py-0.5 text-xs font-medium shadow-xs dark:bg-input/30">{skill}</li>
        ))}
      </ul>
    )
  }
</div>
