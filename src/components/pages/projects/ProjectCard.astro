---
import { Image } from "astro:assets";
import { Clock, ExternalLink, Lock, Star } from "@lucide/astro";
import AppImage from "@/components/ui/AppImage.astro";
import Bullets from "@/components/ui/Bullets.astro";
import Chips from "@/components/ui/Chips.astro";
import HighlightedText from "@/components/ui/HighlightedText.astro";
import { GlobalMessageKeys, getTranslations, type Locale } from "@/i18n";
import { ICONS } from "@/lib/constants/icons";
import { buttonVariants } from "@/lib/ui";
import { cn } from "@/lib/utils";
import type { ProjectItem } from "./data";

interface Props {
  project: ProjectItem;
  locale: Locale;
  /** Large horizontal layout used for featured projects. */
  featured?: boolean;
}

const { project, locale, featured = false } = Astro.props;
const { key, image, imagePosition = "object-top", kind, company, href, githubHref, comingSoon, skills } = project;
const t = getTranslations(locale, GlobalMessageKeys.Projects);

const title = t(`${key}.title`);
const live = Boolean(href && !comingSoon);
const kindLabel = [t(`labels.${kind}`), company].filter(Boolean).join(" · ");
const highlights = t.numberedKeys(key, "highlight_").map((highlightKey) => t(`${key}.${highlightKey}`));
const domain = href ? new URL(href).hostname : null;
---

<article
  class={cn(
    "group flex flex-col overflow-hidden rounded-xl border bg-card text-card-foreground shadow-sm transition-[border-color,box-shadow] duration-300 hover:border-violet-500/40 hover:shadow-md",
    featured && "lg:grid lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]",
  )}
>
  {/* Screenshot */}
  <div
    class={cn(
      "relative aspect-video overflow-hidden border-b bg-muted",
      featured && "lg:aspect-auto lg:min-h-[24rem] lg:border-r lg:border-b-0",
    )}
  >
    {
      live ? (
        <a href={href} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
          <Image
            src={image}
            alt=""
            width={1280}
            widths={[480, 720, 960, 1280]}
            sizes={featured ? "(min-width: 1024px) 640px, 100vw" : "(min-width: 768px) 560px, 100vw"}
            class={cn("absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]", imagePosition)}
          />
        </a>
      ) : (
        <Image
          src={image}
          alt=""
          width={1280}
          widths={[480, 720, 960, 1280]}
          sizes={featured ? "(min-width: 1024px) 640px, 100vw" : "(min-width: 768px) 560px, 100vw"}
          class={cn("absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]", imagePosition)}
        />
      )
    }
    {
      featured && (
        <span class="absolute top-3 left-3 inline-flex items-center gap-1 rounded-full bg-violet-600 px-2.5 py-1 text-xs font-semibold text-white shadow-sm">
          <Star class="size-3.5 fill-current" />
          {t("labels.featured")}
        </span>
      )
    }
    {
      comingSoon && (
        <span class="absolute top-3 right-3 inline-flex items-center gap-1 rounded-full bg-amber-400 px-2.5 py-1 text-xs font-semibold text-amber-950 shadow-sm">
          <Clock class="size-3.5" />
          {t("labels.comingSoon")}
        </span>
      )
    }
  </div>

  {/* Content */}
  <div class={cn("flex flex-1 flex-col gap-4 p-5 sm:p-6", featured && "lg:p-8")}>
    <div class="flex flex-col gap-2">
      <p class="text-xs font-semibold tracking-widest text-violet-700 uppercase dark:text-violet-300">{kindLabel}</p>
      <h3 class={cn("leading-tight font-bold", featured ? "text-2xl" : "text-xl")}>{title}</h3>
      <p class="leading-relaxed text-secondary">
        <HighlightedText text={t(`${key}.summary`)} />
      </p>
    </div>

    <Bullets items={highlights} class="text-sm" />
    <Chips items={skills} label="Stack" />

    <div class="mt-auto flex flex-wrap items-center gap-3 border-t pt-4">
      {
        live && (
          <a href={href} target="_blank" rel="noopener" class={cn(buttonVariants({ variant: "outline" }))}>
            <ExternalLink />
            {t("labels.viewSite")}
          </a>
        )
      }
      {
        githubHref && (
          <a href={githubHref} target="_blank" rel="noopener" class={cn(buttonVariants({ variant: "outline" }))}>
            <AppImage src={ICONS.github} alt="" width={16} height={16} class="size-4 dark:invert" />
            {t("labels.sourceCode")}
          </a>
        )
      }
      {
        comingSoon && domain && (
          <span class="inline-flex items-center gap-1.5 text-sm text-secondary">
            <Clock class="size-4" />
            {t("labels.comingSoon")} · <span class="font-mono text-xs">{domain}</span>
          </span>
        )
      }
      {
        !href && (
          <span class="inline-flex items-center gap-1.5 text-sm text-secondary">
            <Lock class="size-4" />
            {t("labels.private")}
          </span>
        )
      }
    </div>
  </div>
</article>
