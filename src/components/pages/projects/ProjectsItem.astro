---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { ExternalLink } from "@lucide/astro";
import AppImage from "@/components/ui/AppImage.astro";
import Card from "@/components/ui/Card.astro";
import Separator from "@/components/ui/Separator.astro";
import { ICONS } from "@/lib/constants/icons";
import { buttonVariants } from "@/lib/ui";
import { cn } from "@/lib/utils";

interface Props {
  image: ImageMetadata;
  title: string;
  description: string;
  tags: string[];
  href?: string;
  githubHref?: string;
}

const { image, title, description, tags, href, githubHref } = Astro.props;
const imageClass = cn("w-full object-cover lg:h-[300px] 2xl:h-[450px] rounded-t-xl border hover:opacity-90", {
  "cursor-not-allowed": !href,
});
---

<Card class="h-full py-0">
  <div class="flex flex-col gap-4 h-full">
    {
      href ? (
        <a href={href} class="lg:h-[300px] 2xl:h-[450px]" target="_blank" rel="noopener">
          <Image
            src={image}
            alt={title}
            width={1440}
            widths={[480, 720, 960, 1440]}
            sizes="(min-width: 1024px) min(704px, 50vw), 100vw"
            class={imageClass}
          />
        </a>
      ) : (
        <div>
          <Image
            src={image}
            alt={title}
            width={1440}
            widths={[480, 720, 960, 1440]}
            sizes="(min-width: 1024px) min(704px, 50vw), 100vw"
            class={imageClass}
          />
        </div>
      )
    }
    <div class="px-6 py-4 flex flex-col gap-4 justify-between h-full">
      <div class="flex flex-col gap-4">
        <h3 class="font-bold text-xl">{title}</h3>
        <p class="text-secondary text-sm whitespace-break-spaces">{description}</p>
      </div>
      <div class="flex flex-col gap-4">
        <div class="flex gap-2 flex-wrap">
          {
            tags.map((tag) => (
              <button type="button" class={cn(buttonVariants({ variant: "outline", className: "!px-3" }))}>
                <p class="!text-xs">{tag}</p>
              </button>
            ))
          }
        </div>
        {
          href && (
            <>
              <Separator />
              <div class="flex items-center gap-6">
                <a href={href} class="flex gap-2" target="_blank" rel="noopener" aria-label={title}>
                  <ExternalLink size={24} />
                </a>
                {githubHref && (
                  <div class="flex gap-2">
                    <a href={githubHref} class="flex gap-2" target="_blank" rel="noopener">
                      <AppImage src={ICONS.github} alt="GitHub" width={24} height={24} class="dark:invert" />
                    </a>
                  </div>
                )}
              </div>
            </>
          )
        }
      </div>
    </div>
  </div>
</Card>
