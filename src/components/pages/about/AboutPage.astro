---
import {
  ArrowRight,
  BrainCircuit,
  BriefcaseBusiness,
  Calendar,
  Check,
  Cloud,
  CodeXml,
  Database,
  FlaskConical,
  GraduationCap,
  Mail,
  MapPin,
  MonitorSmartphone,
  Server,
  Target,
  TrendingUp,
} from "@lucide/astro";
import SectionTitle from "@/components/sections/SectionTitle.astro";
import Chips from "@/components/ui/Chips.astro";
import HighlightedText from "@/components/ui/HighlightedText.astro";
import { currentRoleKey, professionalYears } from "@/components/pages/experience/data";
import { GlobalMessageKeys, getTranslations, localizePath, type Locale } from "@/i18n";
import { formatYearMonth } from "@/lib/dates";
import { Paths } from "@/lib/paths";
import { buttonVariants } from "@/lib/ui";
import { cn } from "@/lib/utils";
import { ABOUT_EDUCATION, ABOUT_SKILLS, type SkillIcon } from "./data";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale, GlobalMessageKeys.About);
const tExperience = getTranslations(locale, GlobalMessageKeys.Experience);

const bio = t.numberedKeys("MainInfo", "content_").map((key) => t(`MainInfo.${key}`));

// "At a glance" facts derived from the experience timeline, so they stay in sync with it.
const roleKey = currentRoleKey();
const currentRole = roleKey
  ? t("Facts.roleValue")
      .replace("{title}", tExperience(`${roleKey}.title`))
      .replace("{company}", tExperience(`${roleKey}.subtitle`))
  : null;
const years = professionalYears();

const facts = [
  currentRole && { icon: BriefcaseBusiness, label: t("Facts.role"), value: currentRole },
  {
    icon: TrendingUp,
    label: t("Facts.experience"),
    value: t("Facts.experienceValue").replace("{count}", String(years)),
  },
  { icon: Target, label: t("Facts.focus"), value: t("Facts.focusValue") },
  { icon: GraduationCap, label: t("Facts.education"), value: t("Facts.educationValue") },
  { icon: MapPin, label: t("Facts.location"), value: t("Facts.locationValue") },
].filter(Boolean) as { icon: typeof MapPin; label: string; value: string }[];

const SKILL_ICONS: Record<SkillIcon, typeof MapPin> = {
  languages: CodeXml,
  backend: Server,
  frontend: MonitorSmartphone,
  ai: BrainCircuit,
  databases: Database,
  cloud: Cloud,
  tests: FlaskConical,
};

const iconTileClass =
  "flex shrink-0 items-center justify-center rounded-lg bg-violet-500/10 text-violet-700 ring-1 ring-violet-500/20 ring-inset dark:text-violet-300";
const cardClass = "rounded-xl border bg-card text-card-foreground shadow-sm";
---

<main class="page-container">
  <SectionTitle title={t("title")} description={t("content")} />

  <div class="flex w-full max-w-6xl flex-col gap-16">
    {/* Bio + quick facts */}
    <section class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-12">
      <div class="flex flex-col gap-5">
        <h3 class="text-2xl font-bold">{t("MainInfo.title")}</h3>
        {
          bio.map((paragraph, index) => (
            <p class={index === 0 ? "text-lg leading-relaxed sm:text-xl" : "leading-relaxed text-secondary"}>
              <HighlightedText text={paragraph} />
            </p>
          ))
        }
      </div>

      <aside class={cn(cardClass, "p-6 lg:sticky lg:top-28")}>
        <p class="text-xs font-semibold tracking-widest text-secondary uppercase">{t("Facts.title")}</p>
        <dl class="mt-5 flex flex-col gap-4">
          {
            facts.map(({ icon: Icon, label, value }) => (
              <div class="flex items-center gap-3">
                <div class={cn(iconTileClass, "size-9")}>
                  <Icon class="size-4" />
                </div>
                <div class="min-w-0">
                  <dt class="text-xs text-secondary">{label}</dt>
                  <dd class="font-semibold leading-snug">{value}</dd>
                </div>
              </div>
            ))
          }
        </dl>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={localizePath(locale, Paths.Experience)} class={cn(buttonVariants({ variant: "default" }))}>
            {t("Facts.ctaExperience")}
            <ArrowRight />
          </a>
          <a href={localizePath(locale, Paths.Contact)} class={cn(buttonVariants({ variant: "outline" }))}>
            <Mail />
            {t("Facts.ctaContact")}
          </a>
        </div>
      </aside>
    </section>

    {/* Skills */}
    <section class="flex flex-col gap-6">
      <h3 class="text-2xl font-bold">{t("Skills.title")}</h3>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          ABOUT_SKILLS.map(({ key, icon, items }, index) => {
            const Icon = SKILL_ICONS[icon];
            return (
              <div
                class={cn(
                  cardClass,
                  "flex flex-col gap-4 p-5 transition-[border-color,box-shadow] duration-300 hover:border-violet-500/40 hover:shadow-md",
                  // The first group (languages) spans the full row so the remaining six fill the grid evenly.
                  index === 0 && "sm:col-span-2 lg:col-span-3",
                )}
              >
                <div class="flex items-center gap-3">
                  <div class={cn(iconTileClass, "size-9")}>
                    <Icon class="size-4" />
                  </div>
                  <h4 class="font-semibold">{t(`Skills.${key}.title`)}</h4>
                </div>
                <Chips items={items} />
              </div>
            );
          })
        }
      </div>
    </section>

    {/* Education + core concepts */}
    <section class="grid gap-12 lg:grid-cols-2">
      <div class="flex flex-col gap-6">
        <h3 class="text-2xl font-bold">{t("Education.title")}</h3>
        <div class="flex flex-col gap-4">
          {
            ABOUT_EDUCATION.map(({ key, initials, start, end, location, graduated }) => (
              <article class={cn(cardClass, "flex items-start gap-4 p-5")}>
                <div aria-hidden="true" class={cn(iconTileClass, "size-12 rounded-xl text-[0.65rem] font-bold tracking-tight")}>
                  {initials}
                </div>
                <div class="flex min-w-0 flex-1 flex-col gap-1">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <h4 class="text-lg leading-tight font-semibold">{t(`Education.${key}.title`)}</h4>
                    {graduated && (
                      <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-emerald-500/20 ring-inset dark:text-emerald-400">
                        <Check class="size-3.5" />
                        {t("Education.graduated")}
                      </span>
                    )}
                  </div>
                  <p class="text-secondary">{t(`Education.${key}.content`)}</p>
                  <ul class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-sm text-secondary">
                    <li class="inline-flex items-center gap-1.5">
                      <Calendar class="size-3.5" />
                      {formatYearMonth(start, locale)} – {formatYearMonth(end, locale)}
                    </li>
                    <li class="inline-flex items-center gap-1.5">
                      <MapPin class="size-3.5" />
                      {location}
                    </li>
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col gap-6">
        <h3 class="text-2xl font-bold">{t("Concepts.title")}</h3>
        <div class={cn(cardClass, "p-5")}>
          <ul class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
            {
              t.numberedKeys("Concepts", "content_").map((key) => (
                <li class="flex items-start gap-2.5">
                  <Check class="mt-0.5 size-4 shrink-0 text-violet-600 dark:text-violet-400" />
                  <span class="text-sm leading-snug">{t(`Concepts.${key}`)}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>
  </div>
</main>
