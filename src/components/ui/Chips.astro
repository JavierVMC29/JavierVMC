---
import { cn } from "@/lib/utils";

interface Props {
  items: string[];
  class?: string;
  label?: string;
}

const { items, class: className, label } = Astro.props;
---

<ul class={cn("flex flex-wrap gap-2", className)} aria-label={label}>
  {items.map((item) => <li class="rounded-md border bg-background px-2 py-0.5 text-xs font-medium shadow-xs dark:bg-input/30">{item}</li>)}
</ul>
