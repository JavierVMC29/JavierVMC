---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import type { PublicIcon } from "@/lib/constants/icons";

interface Props {
  /** A `public/` icon, an imported raster image (optimized by Astro) or a remote URL. */
  src: PublicIcon | ImageMetadata | string;
  alt: string;
  /** Rendered width; defaults to the intrinsic width. Required for remote URLs. */
  width?: number;
  height?: number;
  class?: string;
}

const { src, alt, width, height, class: className } = Astro.props;

const isOptimized = typeof src === "object" && "format" in src;
// Public SVG icons keep their intrinsic size unless both dimensions are given.
const plain =
  typeof src === "string" ? { src, width, height } : !isOptimized ? { ...src, ...(width && height && { width, height }) } : null;
---

{
  isOptimized ? (
    <Image src={src as ImageMetadata} alt={alt} width={width} class={className} />
  ) : (
    <img src={plain!.src} alt={alt} width={plain!.width} height={plain!.height} loading="lazy" decoding="async" class={className} />
  )
}
